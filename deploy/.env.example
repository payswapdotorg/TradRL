# deploy/.env.example — EVERY environment variable the T052 deployment
# consumes (the single inventory; deploy/README.md documents each).
#
# SECRETS ARE NEVER HARDCODED. Copy the relevant keys into the Vercel
# project's Environment Variables (Production + Preview) or your local
# shell — never into the repository. Every key below is either:
#   [function]  consumed by the serverless API function at runtime, or
#   [build]     consumed by deploy/vercel/build-console.mjs at build time, or
#   [W-3b..e]   reserved for the adapter chunks (documented now, wired then).

# ---------------------------------------------------------------------------
# The API plane (functions) — the T041 boundary's host-owned injections
# ---------------------------------------------------------------------------

# [function] The public-plane developer credential token. Host-minted at the
# secure boundary (generate: openssl rand -hex 24). This is the token the
# console's shell carries (TRADRL_CONSOLE_TOKEN must be the SAME value).
TRADRL_API_DEVELOPER_TOKEN=

# [function] The developer credential's L12 tenant id — the isolation root
# injected into EVERY request that token makes (non-empty string, e.g.
# 'tenant-demo').
TRADRL_API_DEVELOPER_TENANT=

# [function] The developer credential's principal name (audit WHO; e.g.
# 'public-console').
TRADRL_API_DEVELOPER_PRINCIPAL=public-console

# [function, optional] The private-plane internal credential token. When
# ABSENT the /internal/* plane stays CLOSED (R46 degradation: internal
# routes answer 401/403 — never a crash).
TRADRL_API_INTERNAL_TOKEN=

# [function, required when TRADRL_API_INTERNAL_TOKEN is set] The internal
# service principal name (e.g. 'job-runner').
TRADRL_API_INTERNAL_PRINCIPAL=

# [function, optional] Which backing services the data routes compose over
# (W-3f). 'demo' = the in-memory demo ports seeded with the fixture demo
# data (per-instance state; the honest public default under the SIMULATED
# badge — byte-identical whether or not Neon keys are present). 'durable'
# = the W-25D hydration seam (runtime/durable.ts) + the W-26B
# activation (runtime/durable-world.ts): the Neon-backed surfaces
# rehydrate from Neon at every cold start with write-through on every
# mutation, and the durable resolution is a SUPERSET of demo (the same
# simulated gateway/jobs engines, the same machinery tick, the same
# demo world seed + fixture substance — every boot-world write drained
# before the first serve); with the Neon keys incomplete those routes
# answer the typed deploy_adapter_absent 503 (R46) and the
# gateway/seed/tick never run.
# UNSET = auto: 'demo' when NO durable-provider key (NEON_*/UPSTASH_*)
# is configured, 'durable' the moment any is. An invalid value fails
# closed (the typed deploy_not_configured 503 naming the key).
TRADRL_DEPLOY_BACKING=

# ---------------------------------------------------------------------------
# The console shell substitution (build time — deploy/vercel/build-console.mjs)
# ---------------------------------------------------------------------------

# [build] The credential token substituted into the shell's
# __TRADRL_CONSOLE__ block. Must equal TRADRL_API_DEVELOPER_TOKEN. Absent ->
# the console boots into its honest no-credential-token degradation.
TRADRL_CONSOLE_TOKEN=

# [build] The tenant id substituted into the shell (L12 scope). Absent -> the
# console boots into its no-tenant degradation.
TRADRL_CONSOLE_TENANT_ID=

# [build, optional] The initial project id ('' = the launchpad).
TRADRL_CONSOLE_PROJECT_ID=

# [build] The SIMULATED environment badge (UX-DESIGN §7 anti-deception).
# DEFAULT true — flip to false ONLY when the durable backing is live
# (the Neon keys configured so the W-25D seam serves real durable data).
TRADRL_CONSOLE_SIMULATED=true

# ---------------------------------------------------------------------------
# Reserved for the adapter chunks (W-3b: neon + upstash; W-3c: r2 + resend +
# apify) — documented here so the inventory is complete; wired there.
# ---------------------------------------------------------------------------

# [W-3b] Neon — the durable Postgres backing stores (HTTPS SQL endpoint).
# NEON_API_HOST is the POOLED endpoint host (ep-xxx-pooler.<region>.aws.neon.tech).
# NEON_API_KEY is the database password of NEON_API_USER (Neon console ->
# the project's connection details; the pooled connection string's password).
# NEON_API_HOST=ep-xxx-pooler.us-east-2.aws.neon.tech
# NEON_DATABASE=neondb
# NEON_API_USER=neondb_owner
# NEON_API_KEY=

# [W-3b] Upstash — the Redis cache + idempotency-key store (REST API).
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# [W-3c] Cloudflare R2 — the evidence/blob store (S3-compatible API).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=

# [W-3c] Resend — email notice delivery (the eight UX.md notice types).
# RESEND_API_KEY=
# RESEND_FROM=console@example.org

# [W-3c] Apify — data-ingestion job runs + schedules (market/news/alt-data).
# APIFY_API_TOKEN=
# APIFY_DEFAULT_RUNS_ENDPOINT=
