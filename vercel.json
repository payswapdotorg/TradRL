{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'zero-dep deployment tree: no install, lockfile untouched'",
  "buildCommand": "node deploy/vercel/build-console.mjs",
  "outputDirectory": "deploy/vercel/dist/console",
  "regions": ["iad1"],
  "functions": {
    "api/router.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/router"
    },
    {
      "source": "/internal/:path*",
      "destination": "/api/router"
    }
  ]
}
